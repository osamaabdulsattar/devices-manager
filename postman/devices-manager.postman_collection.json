{
  "info": {
    "_postman_id": "a9b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "name": "Devices Manager API",
    "description": "Collection of requests for testing Devices Manager REST API with automated variable capture and tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "brandId",
      "value": "3f8e2a1c-7b5d-4c9e-8f6a-1d2c3b4a5e6f",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "9b2f6c1e-4d3a-4e8b-a7c5-2f1d0e9b8a76",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Devices",
      "item": [
        {
          "name": "Fetch All Devices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"]
            },
            "description": "Retrieves all devices without filters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set(\"deviceId\", jsonData[0].id);",
                  "        pm.collectionVariables.set(\"brandId\", jsonData[0].brand.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter Devices by State (available)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?state=available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "state",
                  "value": "available"
                }
              ]
            },
            "description": "Fetch devices with state=available."
          }
        },
        {
          "name": "Filter Devices by State (in-use)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?state=in-use",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "state",
                  "value": "in-use"
                }
              ]
            },
            "description": "Fetch devices with state=in-use."
          }
        },
        {
          "name": "Filter Devices by State (inactive)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?state=inactive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "state",
                  "value": "inactive"
                }
              ]
            },
            "description": "Fetch devices with state=inactive."
          }
        },
        {
          "name": "Filter Devices by Brand ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?brandId={{brandId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "brandId",
                  "value": "{{brandId}}"
                }
              ]
            },
            "description": "Filter devices belonging to a specific brand UUID."
          }
        },
        {
          "name": "Filter Devices by Brand Name Substring",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?brandName=app",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "brandName",
                  "value": "app"
                }
              ]
            },
            "description": "Filter devices by brand name (case-insensitive substring, e.g. 'app' matches 'Apple')."
          }
        },
        {
          "name": "Filter Devices with Combined Criteria",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices?brandName=Apple&state=available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"],
              "query": [
                {
                  "key": "brandName",
                  "value": "Apple"
                },
                {
                  "key": "state",
                  "value": "available"
                }
              ]
            },
            "description": "Combined filter: brand name + state."
          }
        },
        {
          "name": "Fetch Single Device by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}"]
            },
            "description": "Retrieves a single device by its UUID."
          }
        },
        {
          "name": "Create Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"brandId\": \"{{brandId}}\",\n  \"state\": \"available\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices"]
            },
            "description": "Creates a new device linked to an existing brand."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set(\"deviceId\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Fully Update Device (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro Max\",\n  \"brandId\": \"{{brandId}}\",\n  \"state\": \"in-use\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}"]
            },
            "description": "Fully replaces all attributes of an existing device."
          }
        },
        {
          "name": "Partially Update Device (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}"]
            },
            "description": "Partially updates attributes (e.g. state only)."
          }
        },
        {
          "name": "Delete Device",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}"]
            },
            "description": "Deletes a device by its UUID."
          }
        }
      ]
    },
